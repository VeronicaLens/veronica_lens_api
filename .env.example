NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:8081
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
PASSWORD_RESET_REDIRECT_URL=veronicalens://auth/reset-password
# Background jobs started with the API server (require SUPABASE_SECRET_KEY).
BACKGROUND_JOBS_ENABLED=true
NOTIFICATION_DISPATCH_INTERVAL_MINUTES=5
EVENT_SYNC_INTERVAL_HOURS=24
EVENT_SYNC_LATITUDE=-23.5505
EVENT_SYNC_LONGITUDE=-46.6333
EVENT_SYNC_ELEVATION=760
EVENT_SYNC_DAYS=31
